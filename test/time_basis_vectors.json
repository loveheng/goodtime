{
  "set": "time-basis",
  "schema": 1,
  "generated": "2026-11-14",
  "generator": "tool/golden/gen_time_vectors.dart",
  "reference": "lib/util/schedule_day.dart（Dart 参考实现，向量生成时点冻结）",
  "consumers": [
    "test/golden/golden_time_test.dart（Dart 基准执行器）",
    "Kotlin 对拍（P2）"
  ],
  "encoding": "日期一律 ISO yyyy-MM-dd（当地时区语义）；分钟制 0..1439",
  "rules": {
    "schedule_day": "作息日以 wake_time 切割而非物理 00:00：minutesOfDay(now) < wake → 前一日历日；**分钟粒度**（秒不参与判定——wake 00:01 前后的秒级输入按分钟折叠）",
    "parse_iso": "yyyy-MM-dd 严格补零；溢出日（02-30）/月越界（13）/未补零（2026-2-5）/非日期串 → null 不回绕；闰年 02-29 接受、非闰年拒绝",
    "cross_midnight": "end < start 即跨午夜（不拆段，按开始日归属）；spanMinutes 经 24:00 折返；端点相接不算重叠（overlapsMinutes 半开区间）",
    "epoch64": "毫秒时间戳 64 位语义：2038-01-19（32 位秒溢出日）毫秒 > 2^31 仍往返无损——**对应 64 位列强制 Long 契约**（禁 Int 列），Kotlin 侧 Long 必选",
    "dst_timezone_defer": "五点中 DST 跳变与时区骤变两点**挂账 Kotlin 时钟基建**：Dart DateTime 本地时区无 tz 库不可注入；Kotlin 侧以 java.time.ZonedDateTime 人工构造期望并过目（TimeProvider + ACTION_TIME_CHANGED 语义，§10 决定 6）"
  },
