  "encoding": "键序敏感（JSON 串逐字对拍——Map 字面量序=序列化契约）；时间毫秒 int（64 位语义）",
  "rules": {
    "payload_v_order": "encodePayload：**v 恒首位**（值取 payload[\"v\"] ?? 1，spread 覆盖不改位）——契约内嵌版本，反序列化按 v 分支；Kotlin 用 LinkedHashMap 同构实现",
    "decode_defense": "decodePayload 读侧防御：raw null/空/畸形 JSON/非 JSON 对象 → **{\"v\":1} 不抛**（[DEGRADE] 日志为旁路可观测，不参与对拍）——库被外部改坏时读路径不挡",
    "to_map_key_order": "Artifact.toMap 键序：id(缺省跳过)/category/source_kind/state/origin/title/badge/payload/attachments/captured_by/plan_id/created_at/updated_at/version——JSON 串逐字对拍（键序=DB 行序列化契约）",
    "from_map_defaults": "fromMap 缺省：badge=null、capturedBy=\"me\"、version=0、planId=null（null=未归属池 D2）",
    "refs_sync": "payloadWithRefs 双写同步单点：planId 参数三态——显式值=置键 / null=移除键 / 缺省(_keep)=保持原值"
  },
