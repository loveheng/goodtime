{
  "set": "command-parse",
  "schema": 1,
  "generated": "2026-11-14",
  "generator": "tool/golden/gen_command_parse_vectors.dart",
  "reference": "lib/action/commands.dart ScheduleCommand.fromJson（Dart 参考实现，向量生成时点冻结）",
  "consumers": [
    "test/golden/golden_command_parse_test.dart（Dart 执行器）",
    "Kotlin 对拍（:core:action GoldenCommandParseTest）"
  ],
  "encoding": "解析语义逐字：_str 空串=null；布尔经字符串 \"true\" 判定（JSON true 同义）；expected_version 字符串/数字均可（int 抽取）",
  "rules": {
    "strict_input": "写入口严进：_reqStr 非空必填 / _objList 数组且元素对象（整组拒）/ _strList 字符串数组（元素类型不对整组拒）/ merge ops kind 非法与 delete 缺 id 拒",
    "defaults": "quick_capture importance 缺省 false；shift minutes 缺省 30；update_plan importance/archived 未给=null（patch 语义——只改传入字段）",
    "cas": "expected_version 字符串数字均可（_int 抽取）；update_plan target_id=id",
    "reject_semantics": "reject_argument = Dart ActionException（HTTP 层仍 200）——Kotlin 对拍断言抛 ActionException 且 message/hint 包含锚文本（异常类非契约，拒绝行为是）"
  },
  "cases": [
    {
      "id": "parse_bad_op",
      "op": "command_parse",
      "input": {
        "json": {
          "op": "no_such_op"
        }
      },
      "expect": {
        "status": "reject_argument",
        "error_hint_contains": "可选 op"
      }
    },
    {
      "id": "parse_missing_op",
      "op": "command_parse",
      "input": {
        "json": {
          "title": "x"
        }
      },
      "expect": {
        "status": "reject_argument",
        "error_hint_contains": "可选 op"
      }
    },
    {
      "id": "parse_quick_capture",
      "op": "command_parse",
      "input": {
        "json": {
          "op": "quick_capture",
          "title": "买牛奶",
          "deadline": "2026-11-20"
        }
      },
      "expect": {
        "op": "quick_capture",
        "target_id": null,
        "title": "买牛奶",
        "importance": false,
        "deadline": "2026-11-20",
        "expected_version": null
      }
    },
    {
      "id": "parse_quick_capture_missing_title",
      "op": "command_parse",
      "input": {
        "json": {
          "op": "quick_capture"
        }
      },
      "expect": {
        "status": "reject_argument",
        "error_contains": "title"
      }
    },
    {
      "id": "parse_update_plan_cas",
      "op": "command_parse",
      "input": {
        "json": {
          "op": "update_plan",
          "id": "p1",
          "title": "新标题",
          "expected_version": "3"
        }
      },
      "expect": {
        "op": "update_plan",
        "target_id": "p1",
        "expected_version": 3,
        "title": "新标题",
        "importance": null,
        "archived": null
      }
    },
    {
      "id": "parse_adjust_blocks_add",
      "op": "command_parse",
      "input": {
        "json": {
          "op": "adjust_blocks",
          "action": "add",
          "date": "2026-11-14",
          "start_min": 540,
          "end_min": 600,
          "pinned": true
        }
      },
      "expect": {
        "op": "adjust_blocks",
        "action": "add",
        "start_min": 540,
        "end_min": 600,
        "pinned": true,
        "target_id": null
      }
    },
    {
      "id": "parse_upsert_facts_objlist_reject",
      "op": "command_parse",
      "input": {
        "json": {
          "op": "upsert_facts",
          "hero_metrics": "not-array"
        }
      },
      "expect": {
        "status": "reject_argument",
        "error_contains": "必须是数组"
      }
    },
    {
      "id": "parse_upsert_background_ok",
      "op": "command_parse",
      "input": {
        "json": {
          "op": "upsert_background",
          "scope": "global",
          "content": "常住深圳"
        }
      },
      "expect": {
        "op": "upsert_background",
        "scope": "global",
        "content": "常住深圳",
        "target_id": null
      }
    },
    {
      "id": "parse_upsert_background_missing_scope",
      "op": "command_parse",
      "input": {
        "json": {
          "op": "upsert_background",
          "content": "x"
        }
      },
      "expect": {
        "status": "reject_argument",
        "error_contains": "scope"
      }
    },
    {
      "id": "parse_merge_bad_kind",
      "op": "command_parse",
      "input": {
        "json": {
          "op": "merge_backgrounds",
          "ops": [
            {
              "kind": "wat"
            }
          ]
        }
      },
      "expect": {
        "status": "reject_argument",
        "error_contains": "kind 非法"
      }
    },
    {
      "id": "parse_merge_delete_no_id",
      "op": "command_parse",
      "input": {
        "json": {
          "op": "merge_backgrounds",
          "ops": [
            {
              "kind": "delete"
            }
          ]
        }
      },
      "expect": {
        "status": "reject_argument",
        "error_contains": "需要非空 id"
      }
    },
    {
      "id": "parse_shift_default_minutes",
      "op": "command_parse",
      "input": {
        "json": {
          "op": "shift_block",
          "id": "b1"
        }
      },
      "expect": {
        "op": "shift_block",
        "target_id": "b1",
        "minutes": 30
      }
    }
  ]
}
