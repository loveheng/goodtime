{
  "set": "mcp-toolface",
  "schema": 1,
  "generated": "2026-11-14",
  "generator": "tool/golden/gen_toolface_vectors.dart",
  "reference": "lib/mcp/tools.dart + lib/action/command_handler.dart（Dart 参考实现，向量生成时点冻结）",
  "consumers": [
    "test/golden/golden_toolface_test.dart（Dart 基准执行器）",
    "Kotlin 对拍（P2）"
  ],
  "encoding": "tool_call 成功返回=值泛化结构对拍（uuid/date/iso_datetime/timestamp_ms 泛化为类型标记，其余原样）；tool_reject 领域码 data.code 值级钉样（message 参考文案不比）",
  "rules": {
    "generalize_rule": "String 匹配 uuid（8-4-4-4-12 hex）→\"uuid\"；YYYY-MM-DDTHH:mm 前缀→\"iso_datetime\"；YYYY-MM-DD→\"date\"；int > 1e12→\"timestamp_ms\"；其余值原样。Kotlin 对拍：同输入→同泛化→结构一致（两侧动态值天然不同，值级对拍仅对枚举/计数/领域码）",
    "ref_rule": "args 叶子 {\"$ref\": \"<seed索引>.<点路径>\"} 解引用到 seed 步骤返回 JSON（已解码）的路径，解决种子内 uuid 引用",
    "error_shape": "领域拒绝统一 ActionException → McpRpcError(-32602, message, {code, hint?, ...data})：HTTP 层仍 200；version_conflict 附 latest 快照；schedule_rejected 附逐条明细与 available_free_windows；budget_exceeded 附全量现场（data_keys 钉键集）",
    "isError": "成功返回 result={content:[{type:text,text:<json 串>}], isError:false}——包装形态已在 mcp-rejection 集钉样，本集只钉 text 内 JSON 载荷",
    "fixups": "update_fixed_slots/suggest_user_setting 的拒绝 data.code 值为实现常量（测试仅钉 throwsA McpRpcError）——拒绝语义已钉样，码值随实现快照入集"
  },
