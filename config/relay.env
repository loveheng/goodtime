# 真 relay 公网地址（联调配置文件；改这里即可，不必写进 flutter run 命令）。
#
# 取值优先级（lib/collab/relay_config.dart）：
#   1. 编译期 --dart-define=RELAY_BASE_URL=...  （CI / 临时覆盖，最高优先）
#   2. 本配置文件 relay.env                （运行时注入，默认联调值）
#   3. 兜底 http://10.0.2.2:8080           （Android 模拟器访问宿主机 relay 回环）
RELAY_BASE_URL=https://gs.oklhj.eu.org
