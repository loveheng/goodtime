# Cloudflare R2 更新源配置（scripts/release-r2.sh 读取）
# 在仓库根 .env 中填真实值（勿提交），或 export 为环境变量
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=shiguang-updates

# 自定义公开域（不含 https://），如 update.example.com
R2_PUBLIC_DOMAIN=update.example.com

# R2 内对象前缀（对应 App 更新源子目录）
REMOTE_PREFIX=updates

# 发布说明（留空则取最近一条 git commit 信息）
CHANGELOG=
