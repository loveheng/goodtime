<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 内嵌 MCP 服务端（LAN 监听）+ 网络可用性 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 应用内自更新：拉起系统安装器（docs/guide/self-update.md） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- 前台服务保活（flutter_foreground_task, dataSync）：管家日切 / MCP Doze 下应答 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- goodhub 本地插件签名权限（契约 §1.2.6，B2）：声明方=服务提供方（本 app），
         goodhub 侧只 <uses-permission>；两 app 须同签名（同机 debug keystore），
         否则 bind 直接 SecurityException（无降级）。 -->
    <permission
        android:name="com.zzh.goodhub.permission.MCP_SERVER"
        android:protectionLevel="signature" />
    <!-- 好友扫码建联：相机扫码读取对方名片二维码（§1.6 / Phase 4.6） -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application
        android:label="拾光"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 分享入口（fact 草案 §1.7）：外部 App 分享纯文本 → raw 入册零解析
                 （一字不解析，origin=shared, state=raw）→ 挂载 sheet 归属。
                 零新权限（ACTION_SEND 纯 intent）；singleTop 下热启动走 onNewIntent。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- flutter_foreground_task 前台服务（勿改名） -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- goodhub 本地 Binder 插件服务（goodhub-local-plugin 终点，thirdconnect.md §1.2.2）：
             exported=true 必须（宿主跨 app bind）；signature 权限护门（B2）；
             发现靠 intent action + SERVER_ID/SERVER_TITLE meta-data（§9.3 非包名约定）。 -->
        <service
            android:name=".ShiguangMcpBinderService"
            android:exported="true"
            android:permission="com.zzh.goodhub.permission.MCP_SERVER">
            <intent-filter>
                <action android:name="com.zzh.goodhub.action.MCP_SERVER" />
            </intent-filter>
            <meta-data
                android:name="com.zzh.goodhub.SERVER_ID"
                android:value="shiguang" />
            <meta-data
                android:name="com.zzh.goodhub.SERVER_TITLE"
                android:value="拾光" />
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
