<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 内嵌 MCP 服务端（LAN 监听）+ 网络可用性 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 应用内自更新：拉起系统安装器（docs/guide/self-update.md） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- 前台服务保活（flutter_foreground_task, dataSync）：管家日切 / MCP Doze 下应答 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- P3 后台服务规格（fgs_housekeeper.md 过目）：specialUse 型 FGS 权限 + 过夜日切精确闹钟 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- goodhub 本地插件签名权限（契约 §1.2.6，B2）：声明方=服务提供方（本 app），
         goodhub 侧只 <uses-permission>；两 app 须同签名（同机 debug keystore），
         否则 bind 直接 SecurityException（无降级）。 -->
    <permission
        android:name="com.zzh.goodhub.permission.MCP_SERVER"
        android:protectionLevel="signature" />
    <!-- 好友扫码建联：相机扫码读取对方名片二维码（§1.6 / Phase 4.6） -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application
        android:label="拾光"
        android:name=".ShiguangApplication"
        android:icon="@mipmap/ic_launcher" android:enableOnBackInvokedCallback="true">
        <!-- P3 前台保活（flutter_foreground_task 平台替换件）：specialUse 型规避
             Android 15 dataSync 配额；subtype 说明挂 P5 发布清单 -->
        <service
            android:name=".service.ShiguangForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="mcp_keepalive_housekeeper"/>
        </service>
        <!-- 过夜日切精确闹钟触发面（manifest 注册，进程死活不丢排程面） -->
        <receiver
            android:name=".service.ShiguangAlarmReceiver"
            android:exported="false"/>
        <activity
            android:name="${activityName}"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 分享入口（fact 草案 §1.7）：外部 App 分享纯文本 → 原生直投 pendingShare
                 零解析（一字不解析，origin=shared, state=raw）→ 挂载 sheet 归属。
                 零新权限（ACTION_SEND 纯 intent）；singleTop 下热启动走 onNewIntent。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- goodhub 本地 Binder 插件服务（goodhub-local-plugin 终点，thirdconnect.md §1.2.2）：
             exported=true 必须（宿主跨 app bind）；signature 权限护门（B2）；
             发现靠 intent action + SERVER_ID/SERVER_TITLE meta-data（§9.3 非包名约定）。 -->
        <service
            android:name=".ShiguangMcpBinderService"
            android:exported="true"
            android:permission="com.zzh.goodhub.permission.MCP_SERVER">
            <intent-filter>
                <action android:name="com.zzh.goodhub.action.MCP_SERVER" />
            </intent-filter>
            <meta-data
                android:name="com.zzh.goodhub.SERVER_ID"
                android:value="shiguang" />
            <meta-data
                android:name="com.zzh.goodhub.SERVER_TITLE"
                android:value="拾光" />
        </service>
    </application>
</manifest>
